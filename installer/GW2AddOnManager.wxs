<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:heat="http://wixtoolset.org/schemas/v4/wxs/heat"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
>
  <Package Compressed="yes"
           Language="1033"
           Manufacturer="GW2ToolBelt"
           Name="Guild Wars 2 Add-On Manager"
           UpgradeCode="64deef2a-cf99-4a0c-be41-5faa802a9502"
           Version="3.0.0.0"
  >
    <MediaTemplate EmbedCab="yes" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed. Setup will now exit." />

    <Feature Id="Application" Title="Installer" Level="1">
      <ComponentRef Id="Main" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentGroupRef Id="HarvestedJarsComponents" />
      <ComponentGroupRef Id="HarvestedRuntimeComponents" />
    </Feature>

    <DirectoryRef Id="INSTALL_DIRECTORY">
      <Component Id="Main" Bitness="always64">
        <File Id="LauncherExe" KeyPath="yes" Source="../build/tmp/bundle/GW2AddOnManager.exe" />
        <File Id="LauncherConfig" Source="../build/tmp/bundle/config.toml" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="Guild Wars 2 Add-On Manager"
                  Description="Launches the Guild Wars 2 Add-On Manager"
                  Target="[INSTALL_DIRECTORY]GW2AddOnManager.exe"
                  WorkingDirectory="INSTALL_DIRECTORY" />

        <RemoveFolder Id="CleanUpShortcut" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Guild Wars 2 Add-On Manager" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALL_DIRECTORY" />

    <UI>
      <ui:WixUI Id="WixUI_InstallDir" />
    </UI>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALL_DIRECTORY" Name="GW2AddOnManager">
        <Directory Id="JarsDirectory" Name="jars" />
        <Directory Id="RuntimeDirectory" Name="runtime" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="GW2AddOnManager" />
    </StandardDirectory>
  </Package>
</Wix>