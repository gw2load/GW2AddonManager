<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);MS_VERSION=$(MS_VERSION)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <HarvestDirectory Include="../build/tmp/bundle/runtime">
      <ComponentGroupName>HarvestedRuntimeComponents</ComponentGroupName>
      <DirectoryRefId>RuntimeDirectory</DirectoryRefId>
      <SuppressRegistry>true</SuppressRegistry>
      <SuppressRootDirectory>true</SuppressRootDirectory>
    </HarvestDirectory>

    <BindPath Include="../build/tmp/bundle/runtime" />
  </ItemGroup>

  <ItemGroup>
    <HarvestDirectory Include="../build/tmp/bundle/libs">
      <ComponentGroupName>HarvestedLibsComponents</ComponentGroupName>
      <DirectoryRefId>LibsDirectory</DirectoryRefId>
      <SuppressRegistry>true</SuppressRegistry>
      <SuppressRootDirectory>true</SuppressRootDirectory>
    </HarvestDirectory>

    <BindPath Include="../build/tmp/bundle/libs" />
  </ItemGroup>

  <ItemGroup>
    <HarvestDirectory Include="../build/tmp/bundle/loader">
      <ComponentGroupName>HarvestedLoaderComponents</ComponentGroupName>
      <DirectoryRefId>LoaderDirectory</DirectoryRefId>
      <SuppressRegistry>true</SuppressRegistry>
      <SuppressRootDirectory>true</SuppressRootDirectory>
    </HarvestDirectory>

    <BindPath Include="../build/tmp/bundle/loader" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Heat" Version="5.*" />
    <PackageReference Include="WixToolset.UI.wixext" Version="5.*" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.*" />
  </ItemGroup>
</Project>